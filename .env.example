# ============================================================================
# Application Environment
# ============================================================================
# Node runtime environment: development | production | test
NODE_ENV=development

# HTTP port the backend API listens on
PORT=3000

# ============================================================================
# PostgreSQL Database Connection
# ============================================================================
# Database host. Use the docker-compose service name ("postgres") when running
# inside containers, or "localhost" when running the backend directly on host.
DB_HOST=postgres

# PostgreSQL server port
DB_PORT=5432

# Name of the database used by the dashboard application
DB_NAME=dashboard_db

# Database user with privileges on DB_NAME
DB_USER=dashboard_user

# Password for DB_USER. Replace with a strong secret before running.
DB_PASSWORD=your_secure_password_here

# ============================================================================
# Database Connection Pool
# ============================================================================
# Minimum number of idle connections kept open in the pool
DB_POOL_MIN=2

# Maximum number of concurrent connections allowed in the pool
DB_POOL_MAX=10

# ============================================================================
# Logging
# ============================================================================
# Application log verbosity: error | warn | info | debug
LOG_LEVEL=info
